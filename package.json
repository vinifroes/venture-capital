{
  "name": "cap-table",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:test": "VITE_BASE_PATH=${VITE_BASE_PATH:-/test/} vite build",
    "build:prod": "VITE_BASE_PATH=${VITE_BASE_PATH:-/} vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "documents:build": "python3 scripts/standardize_documents.py",
    "ci:verify": "SOURCE_DATE_EPOCH=0 npm run documents:build && git diff --exit-code -- src/documents_json src/documents_json/index.json && npm run lint && npm run build"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^8.0.0-beta.13"
  },
  "overrides": {
    "vite": "^8.0.0-beta.13"
  }
}
